  "pyzmq": "25.1.2",
  "libzmq": "4.3.4",
  "source_behavior": {
    "roles": [
      "train",
      "sample",
      "inference",
      "communication",
      "evaluate"
    ],
    "transport": "REQ/REP structured native NumPy records + JSON info",
    "version_in_action_message": false,
    "old_log_probability_in_remote_reply": false,
    "parameter_sync": "inference copies shared MAC if agent_version increases; no snapshot acknowledgement",
    "shared_slots": "bounded shared_idx and episode_idx queues, but blocking Queue.get/put have no deadlines",
    "socket_ownership": "InferServer receives/sends the same REP sockets from different threads",
    "stop": "flags plus force kill; no systematic socket/context close, join or sentinel unblocking",
    "client_poll_ms": 500000
  },
  "integration_decisions": {
    "reuse": "Stage5 algorithm classes, EpisodeBatch, source ReplayBuffer, source PPO/vtrace losses",
    "replace": "wire ABI, thread/socket ownership, shared queues and lifecycle with versioned bounded ZMQ execution",
    "modes": {
      "Qmix/VDN": [
        "local",
        "zmq sync",
        "zmq async"
      ],
      "PPO": [
        "local fresh synchronous",
        "zmq sync"
      ],
      "PPO use_vtrace=true": [
        "local",
        "zmq sync",
        "zmq async replay"
      ]
    },
    "message_compatibility": "new protocol=1; not compatible with original InferClient binary records",
    "platform": "Windows spawn; no sh/pgrep/kill script or fork requirement",
    "cross_machine": "NOT_VALIDATED: no remote host supplied",
    "distributed_evaluation": "Not migrated as a continuous worker; saved policy evaluate() remains available"
  }
